# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-only; never expose to the browser

# ---- Auth (simple hash-based login) ----
ADMIN_USERNAME=khalid
ADMIN_PASSWORD_HASH=            # run: node scripts/hash.js <your-password>
AUTH_SALT=change-me-random
# Required: set AUTH_SECRET and CRON_SECRET to independent random secrets (16+ characters).
# Login/protected routes and cron jobs fail closed when their secrets are unconfigured.
# Set both in Vercel before deploying. Login attempts are limited per serverless instance.
# Keep AUTH_SALT identical to the value used by scripts/hash.js; changing it requires a new hash.
AUTH_SECRET=                  # signs session tokens; no default

# ---- Cron (cron-job.org calls /api/poll-disclosures?secret=...) ----
CRON_SECRET=                  # required; query secret and header credentials are supported

# ---- Data feeds (leave blank for now; app runs on mock adapters) ----
# Financial Modeling Prep — powers BOTH real disclosures (SEC/Congress via
# api/_lib/sources/fmp.js) AND real prices (api/refresh-prices.js). Without it,
# poll-disclosures uses the mock source and charts stay "Pending". Free tier = 250 calls/day.
FMP_API_KEY=
QUIVER_API_KEY=                 # alternative disclosure source (optional)
# Prices: TWELVEDATA_API_KEY powers api/refresh-prices.js. PRICE_BATCH_SIZE = tickers refreshed per call
# (default 8 = free tier's 8 req/min; e.g. 60 on a paid plan). Optional repo variable PRICE_LOOP_SLEEP
# (seconds between cron calls, default 61; e.g. 5 on a paid plan).
TWELVEDATA_API_KEY=
PRICE_BATCH_SIZE=
# Institutional 13F funds straight from SEC EDGAR (api/_lib/sources/edgar13f.js). Off unless
# ENABLE_13F=1. SEC_USER_AGENT is REQUIRED by SEC fair-access policy: "<App/Company> <contact email>".
ENABLE_13F=
SEC_USER_AGENT=
OPENFIGI_API_KEY=               # optional: raises OpenFIGI CUSIP->ticker limits (100 jobs/request)
# Optional tuning: SEC13F_TOP_N (25), SEC13F_FUNDS_PER_RUN (1), SEC13F_MAX_AGE_DAYS (200)
# Sharia screening. Leave SCREENING_API_KEY blank to run on the mock adapter.
# When set, SCREENING_PROVIDER picks the live adapter: halalterminal (default) | zoya.
# The screenings cache (~30-day refresh) keeps usage within the free-tier quota.
SCREENING_API_KEY=
SCREENING_PROVIDER=halalterminal
# Optional override of the screening API base URL (defaults per adapter).
SCREENING_API_BASE=

# ---- AI (optional, later) ----
ANTHROPIC_API_KEY=
