# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-only; never expose to the browser

# ---- Auth (simple hash-based login) ----
ADMIN_USERNAME=khalid
ADMIN_PASSWORD_HASH=            # run: node scripts/hash.js <your-password>
AUTH_SALT=change-me-random
AUTH_SECRET=change-me-random   # signs session tokens

# ---- Cron (cron-job.org calls /api/poll-disclosures?secret=...) ----
CRON_SECRET=change-me-random

# ---- Data feeds (leave blank for now; app runs on mock adapters) ----
# Financial Modeling Prep — powers BOTH real disclosures (SEC/Congress via
# api/_lib/sources/fmp.js) AND real prices (api/refresh-prices.js). Without it,
# poll-disclosures uses the mock source and charts stay "Pending". Free tier = 250 calls/day.
FMP_API_KEY=
QUIVER_API_KEY=                 # alternative disclosure source (optional)
# Sharia screening. Leave SCREENING_API_KEY blank to run on the mock adapter.
# When set, SCREENING_PROVIDER picks the live adapter: halalterminal (default) | zoya.
# The screenings cache (~30-day refresh) keeps usage within the free-tier quota.
SCREENING_API_KEY=
SCREENING_PROVIDER=halalterminal
# Optional override of the screening API base URL (defaults per adapter).
SCREENING_API_BASE=

# ---- AI (optional, later) ----
ANTHROPIC_API_KEY=
